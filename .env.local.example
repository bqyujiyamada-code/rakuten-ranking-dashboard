AWS_REGION=ap-northeast-1
# ローカル開発でDynamoDB Localを使う場合のみ設定 (例: http://localhost:8000)
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_NAME=RakutenRankings

# DynamoDBにアクセスするためのIAMユーザー認証情報
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

RAKUTEN_APP_ID=your_rakuten_application_id
# 2026年のインフラ移行後の新エンドポイント(openapi.rakuten.co.jp)で追加必須になったAccess Key
RAKUTEN_ACCESS_KEY=your_rakuten_access_key

GEMINI_API_KEY=your_gemini_api_key

# /api/cron/collect を外部スケジューラ(EventBridge Scheduler / Vercel Cron等)から
# 叩く際の認証用シークレット。Authorization: Bearer <CRON_SECRET> を要求する。
CRON_SECRET=change_me
